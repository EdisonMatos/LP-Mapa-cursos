<style>
  @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap");

  .logo-familias,
  .logo-familias * {
    box-sizing: border-box;
  }

  .logo-familias {
    --dourado-borda: #a9672c;
    --dourado-claro: #e2aa69;
    --dourado-titulo: #d78c43;
    --rose-claro: #e0b19d;

    position: relative;
    width: 100%;
    max-width: 430px;
    aspect-ratio: 4.15 / 1;
    margin: 0 auto;

    container-type: inline-size;
    isolation: isolate;
    overflow: visible;

    font-family: "Montserrat", Arial, sans-serif;
  }

  /* Estrutura horizontal principal */
  .logo-familias__estrutura {
    position: absolute;
    inset: 0;

    border: 1.3px solid transparent;
    border-radius: 999px;

    background:
      linear-gradient(180deg, #080808 0%, #030303 55%, #070707 100%) padding-box,
      linear-gradient(
          105deg,
          #764117 0%,
          #d49650 20%,
          #9b591f 48%,
          #b86f2e 76%,
          #744016 100%
        )
        border-box;

    box-shadow:
      0 3px 8px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 rgba(255, 196, 122, 0.025);
  }

  /* Pequeno brilho sobre a borda superior */
  .logo-familias__brilho {
    position: absolute;
    z-index: 4;

    top: -2.5%;
    left: 13%;
    width: 24%;
    height: 8%;

    background: radial-gradient(
      ellipse at center,
      rgba(255, 233, 190, 0.95) 0%,
      rgba(240, 166, 81, 0.75) 17%,
      rgba(201, 111, 35, 0.3) 42%,
      transparent 73%
    );

    filter: blur(0.5px);
    pointer-events: none;
  }

  /* Círculo do ícone */
  .logo-familias__circulo {
    position: absolute;
    z-index: 5;

    top: 0;
    left: 0;
    width: 24.1%;
    aspect-ratio: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1.35px solid transparent;
    border-radius: 50%;

    background:
      radial-gradient(circle at 45% 38%, #171717 0%, #090909 48%, #030303 100%)
        padding-box,
      linear-gradient(
          140deg,
          #d69b58 0%,
          #8d501e 34%,
          #c27b35 66%,
          #714018 100%
        )
        border-box;

    box-shadow:
      0 3px 7px rgba(0, 0, 0, 0.88),
      0 0 3px rgba(203, 119, 46, 0.15);
  }

  /* Aro interno mais discreto */
  .logo-familias__circulo::before {
    content: "";
    position: absolute;
    inset: 8%;

    border: 1px solid rgba(184, 105, 42, 0.38);
    border-radius: 50%;

    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.85);

    pointer-events: none;
  }

  /* Brilho interno suave */
  .logo-familias__circulo::after {
    content: "";
    position: absolute;
    inset: 11%;
    border-radius: 50%;

    background: radial-gradient(
      circle at 43% 35%,
      rgba(255, 255, 255, 0.055) 0%,
      transparent 58%
    );

    pointer-events: none;
  }

  /* Imagem da família carregada por URL */
  .logo-familias__icone {
    position: relative;
    z-index: 2;

    display: block;
    width: 58%;
    max-width: 58%;
    height: 68%;

    object-fit: contain;
    object-position: center;

    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.85))
      drop-shadow(0 0 2px rgba(222, 157, 126, 0.15));
  }

  /* Conteúdo textual */
  .logo-familias__conteudo {
    position: absolute;
    z-index: 3;

    top: 15.5%;
    left: 26.5%;
    right: 5.6%;

    text-align: center;
    line-height: 1;
    white-space: nowrap;
  }

  /* Texto superior */
  .logo-familias__superior {
    margin: 0 0 1.4cqw;

    font-size: 3.78cqw;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.045em;

    color: #c5a884;

    background: linear-gradient(180deg, #c5a884 0%, #b69a72 48%, #c5a884 100%);

    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;

    text-shadow:
      0 0 4px rgba(197, 168, 132, 0.12),
      0 1px 1px rgba(0, 0, 0, 0.65);
  }

  /* Texto principal */
  .logo-familias__titulo {
    margin: 0;

    font-size: 5.25cqw;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;

    color: #c5a884;

    background: linear-gradient(180deg, #c5a884 0%, #b69a72 45%, #c5a884 100%);

    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;

    text-shadow:
      0 0 5px rgba(197, 168, 132, 0.14),
      0 1px 1px rgba(0, 0, 0, 0.75);
  }

  /* Linha inferior */
  .logo-familias__localizacao {
    width: 100%;
    margin-top: 1.7cqw;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 3.1cqw;
  }

  /* Linhas ao lado de Niterói */
  .logo-familias__linha {
    display: block;
    height: 1px;

    background: linear-gradient(
      90deg,
      rgba(136, 71, 23, 0.65) 0%,
      #d99748 46%,
      rgba(145, 77, 26, 0.7) 100%
    );

    box-shadow: 0 0 2px rgba(218, 139, 58, 0.24);
  }

  /* Niterói */
  .logo-familias__cidade {
    font-size: 4.6cqw;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.13em;

    color: #c5a884;

    background: linear-gradient(180deg, #c5a884 0%, #b69a72 48%, #c5a884 100%);

    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;

    text-shadow:
      0 0 4px rgba(197, 168, 132, 0.12),
      0 1px 1px rgba(0, 0, 0, 0.7);
  }

  /* Ajuste para telas muito pequenas */
  @media (max-width: 380px) {
    .logo-familias__conteudo {
      left: 26.8%;
      right: 4.5%;
    }

    .logo-familias__superior {
      letter-spacing: 0.025em;
    }

    .logo-familias__cidade {
      letter-spacing: 0.1em;
    }
  }

  /* Fallback para navegadores mais antigos */
  @supports not (font-size: 1cqw) {
    .logo-familias__superior {
      font-size: 16px;
      margin-bottom: 6px;
    }

    .logo-familias__titulo {
      font-size: 22px;
    }

    .logo-familias__localizacao {
      margin-top: 7px;
      column-gap: 13px;
    }

    .logo-familias__cidade {
      font-size: 19px;
    }
  }
</style>

<div
  class="logo-familias"
  role="img"
  aria-label="Atuação com foco no Direito das Famílias em Niterói"
>
  <div class="logo-familias__estrutura"></div>
  <div class="logo-familias__brilho"></div>

  <div class="logo-familias__circulo">
    <img
      class="logo-familias__icone"
      src="https://paperstreet.com.br/assets/logo-CbJtwANr.webp"
      alt="Ícone de uma mulher, um homem e uma criança"
      loading="eager"
      decoding="async"
    />
  </div>

  <div class="logo-familias__conteudo">
    <div class="logo-familias__superior">ATUAÇÃO COM FOCO NO</div>

    <div class="logo-familias__titulo">DIREITO DAS FAMÍLIAS</div>

    <div class="logo-familias__localizacao">
      <span class="logo-familias__linha"></span>

      <span class="logo-familias__cidade"> NITERÓI </span>

      <span class="logo-familias__linha"></span>
    </div>
  </div>
</div>
